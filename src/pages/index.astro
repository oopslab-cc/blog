---
import { getCollection } from "astro:content";

import PostList from "../components/PostList.astro";
import { siteConfig } from "../config";
import PageLayout from "../layouts/PageLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const siteUrl = new URL("/", Astro.site ?? Astro.url.origin).href;
const logoUrl = new URL(siteConfig.logo, siteUrl).href;
const organizationId = `${siteConfig.authorUrl}/#organization`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: siteConfig.title,
      alternateName: `${siteConfig.title} blog`,
      description: siteConfig.description,
      url: siteUrl,
      inLanguage: siteConfig.lang,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "Blog",
      "@id": `${siteUrl}#blog`,
      name: siteConfig.title,
      description: siteConfig.description,
      url: siteUrl,
      inLanguage: siteConfig.lang,
      isPartOf: { "@id": `${siteUrl}#website` },
      publisher: {
        "@type": "Organization",
        "@id": organizationId,
        name: siteConfig.author,
        url: siteConfig.authorUrl,
        logo: {
          "@type": "ImageObject",
          url: logoUrl,
          width: 800,
          height: 800,
        },
      },
    },
  ],
};
---

<PageLayout
  title={siteConfig.title}
  heading="Blog"
  description={siteConfig.tagline}
  metaDescription={siteConfig.description}
  {jsonLd}
>
  <section aria-labelledby="latest-posts">
    <h2 id="latest-posts" class="mb-6 text-xl font-semibold tracking-tight">
      최근 글
    </h2>
    <PostList {posts} />
  </section>
</PageLayout>
